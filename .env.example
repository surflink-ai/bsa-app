# ── Supabase ─────────────────────────────────────────────────────────────
# Public (safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — NEVER expose to the browser or commit it.
# Used by cron routes and CLI scripts (athlete import, surf cache, event sync).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ─────────────────────────────────────────────────────────────────
# Canonical origin for metadata/sitemap/robots. Override on preview deploys.
NEXT_PUBLIC_SITE_URL=https://bsa.surf

# ── LiveHeats ──────────────────────────────────────────────────────────────
# Default SOTY series id used by rankings + OG cards.
NEXT_PUBLIC_LIVEHEATS_SERIES_ID=27909
# Fallback live-event id if the site_settings 'live_event' row is empty.
LIVEHEATS_LIVE_EVENT_ID=

# ── Cron (Vercel) ─────────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/* routes.
# Required — cron routes fail closed (401) without it.
CRON_SECRET=generate-a-long-random-string

# ── Surfline (surf cache pipeline) ────────────────────────────────────────
# Premium access token + refresh token (optional; falls back to free tier).
SURFLINE_ACCESS_TOKEN=
SURFLINE_REFRESH_TOKEN=
# Surfline app client auth: either "clientId:clientSecret" or "Basic <base64>".
SURFLINE_CLIENT_AUTH=
# Proxy that fronts Surfline (CF Worker or the Vercel /api/surfline-proxy).
SURFLINE_PROXY_BASE=
# Shared secret for the proxy. Proxies fail CLOSED when this is unset.
SURFLINE_PROXY_SECRET=
# (CLI/worker alias for the proxy secret)
SURFLINE_PROXY_KEY=

# ── Telegram surf report ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Override the conditions API the report reads (defaults to prod).
CONDITIONS_URL=

# ── Twilio (WhatsApp blasts) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
# Max recipients per blast (cost guardrail). Defaults to 500.
MAX_BLAST_RECIPIENTS=500

# ── Rate limiting (optional) ──────────────────────────────────────────────
# When set, public API rate limiting uses Upstash Redis (accurate across
# serverless instances). Without it, an in-memory best-effort limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
